{
    "name": "@korva.io/mira",
    "version": "1.0.0",
    "description": "AI-powered database query interpreter",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc && terser dist/index.js -o dist/index.min.js",
        "start": "node dist/index.js",
