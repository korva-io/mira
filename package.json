        "fastify": "^4.24.3",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.3.0",
        "neverthrow": "^6.1.0",
        "pg": "^8.11.3",
        "redis": "^5.5.6",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.10.0",
        "@types/pg": "^8.10.9",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "husky": "^8.0.3",
        "lint-staged": "^15.2.0",
